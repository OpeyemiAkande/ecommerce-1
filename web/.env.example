NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=NGN
NEXT_PUBLIC_STORE_NAME=Store

# Must be the same Clerk application the backend and mobile app use.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional: browser error reporting (same values the old admin used as VITE_SENTRY_*).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
